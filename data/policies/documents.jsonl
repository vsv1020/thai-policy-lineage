{"uid":"TH-RD-2565-DECREE-743","issue_id":"ltr-visa","titles":{"zh":"皇家法令第 743 号(佛历 2565):LTR 长期居留签证持有人所得税优惠","th":"","en":"Royal Decree No. 743 B.E. 2565"},"summary_zh":"依第 5 条对 LTR(Long-Term Resident)长期居留签证持有人给予个人所得税优惠。该法令是 LTR 签证税务待遇的法律依据,签证本身依《移民法》B.E. 2522 签发、由 BOI 依《投资促进法》B.E. 2520 管理。","instrument_ids":["tax_incentive"],"goal_ids":["investment_attraction"],"implementation_stage":"legal_form","subjects":["ltr_visa","personal_income_tax"],"agency_ids":["rd","boi"],"domain_ids":["tax","visa"],"legal_form_id":"decree","status_id":"in_force","direction":{"value":"loose","confidence":"high","method":"manual"},"doc_no":"พ.ร.ฎ. 743/2565","gazette":{"series":"ก","volume":null,"part":"","page":null},"dates":{"resolved_at":null,"published_at":"2022-05-23","effective_from":null,"effective_to":null,"comment_deadline":null},"affected_parties":[{"party_id":"foreign_resident","stance":"support"},{"party_id":"foreign_investor","stance":"support"}],"relations":[{"type":"implemented_by","uid":"TH-RD-2565-DG-427"}],"sources":[{"role":"secondary","url":"","note":"律所与会计师事务所法规更新一致引述刊登日 2022-05-23"}],"provenance":{"pipeline":"research","run_at":"2026-08-11T01:10:00+07:00","verified":false,"verified_at":null},"confidence":{"dates":"med","doc_no":"med"},"flags":{"has_detail_page":false},"note":"公报卷期号未取得;皇家法令属 พ.ร.ฎ. 层级,稳定性高于公告"}
