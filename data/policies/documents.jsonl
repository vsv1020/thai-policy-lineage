{"uid": "TH-CAB-20260519-VISAFREE-30D", "issue_id": "visa-free-duration", "titles": {"zh": "内阁决议:终止 60 天免签、多数国籍改回 30 天(截至 8 月初尚未刊登公报)", "th": "", "en": ""}, "summary_zh": "内阁于 2026-05-19 批准终止 60 天免签入境安排,多数国籍恢复为 30 天,须由内政部公告刊登皇家公报后满 15 日生效。截至 2026-08-03 相关公告尚未刊登,现行 60 天免签仍然有效 —— 这是「内阁决议已过、公报未刊」的典型窗口期,以公报刊登日为准。", "agency_ids": ["cabinet", "moi"], "domain_ids": ["visa"], "legal_form_id": "resolution", "status_id": "pending_gazette", "direction": {"value": "tight", "confidence": "med", "method": "llm"}, "doc_no": "", "gazette": null, "dates": {"resolved_at": "2026-05-19", "published_at": null, "effective_from": null, "effective_to": null, "comment_deadline": null}, "instrument_ids": ["standards_licensing"], "goal_ids": ["order_security"], "implementation_stage": "cabinet_resolution", "subjects": ["visa_exemption", "length_of_stay"], "affected_parties": [{"party_id": "traveller", "stance": "constrain"}], "relations": [], "sources": [{"role": "secondary", "url": "", "note": "公开检索聚合摘要,未取得内阁决议原文链接"}], "provenance": {"pipeline": "research", "run_at": "2026-08-10T23:53:23+07:00", "verified": false, "verified_at": null}, "confidence": {"dates": "med", "doc_no": "none"}, "flags": {"has_detail_page": false}, "note": "生效取决于内政部公告刊登日 + 15 日"}
