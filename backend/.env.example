# 复制成 .env 后按需改。所有值都有默认,空文件也能跑。

# ── 数据库 ──
# 开发(默认):SQLite 落在仓库的 var/policy.db
# DATABASE_URL=sqlite:////srv/policy/var/policy.db
# 生产:Postgres(pip install 'psycopg[binary]')
# DATABASE_URL=postgresql+psycopg://policy:PASSWORD@127.0.0.1:5432/policy
ECHO_SQL=0

# ── 每日采集 ──
# 曼谷时间几点几分跑。避开整点,别和全世界的定时任务撞在 :00
COLLECT_HOUR=7
COLLECT_MINUTE=23
# 进程内定时器。若改用系统 cron / systemd timer,设为 0
ENABLE_SCHEDULER=1
# 只收多少天之内的信号
RECENCY_DAYS=7
# 礼貌限速:单站每请求最小间隔(秒)。不要调低于 1
MIN_REQUEST_INTERVAL=1.0
HTTP_TIMEOUT=30
# 采集完是否顺带导出 data/site/*.json(给 GitHub Pages 静态降级用)
EXPORT_AFTER_COLLECT=1

# ── API ──
# 前端所在源。GitHub Pages 的域名要写进来,否则浏览器会拦跨域请求
CORS_ORIGINS=http://localhost:8000,https://vsv1020.github.io
API_PREFIX=/api

# ── 分析口径(改这里就改了全站显示)──
# 风向指数收缩系数:越大越保守,样本少时越贴近中性
WIND_SHRINK=2.0
TREND_MONTHS=12
# 覆盖月份少于这个数,趋势图退回演示数据而不是硬画
MIN_TREND_MONTHS=6
CALENDAR_DAYS=90
FEED_SIZE=6

# ── 安全 ──
# 每个客户端 IP 每分钟 /api 请求上限;0 = 关闭(交给反向代理)
API_RATE_PER_MIN=120
# 在 Caddy/nginx 后面时设 1,才会信任 X-Forwarded-For;直接暴露公网时必须为 0
TRUST_PROXY=0

# ── LLM 翻译分类(app.enrich)──
# 不设则跳过翻译:采集照常,但官方接口采回的泰文条目不会出现在首页
# ANTHROPIC_API_KEY=sk-ant-...
ENRICH_MODEL=claude-opus-5
ENRICH_MAX_PER_RUN=40
ENRICH_AFTER_COLLECT=1

# ── SEO ──
# 站点公开地址,用于落地页 canonical 与 sitemap。换成你的域名
SITE_URL=https://vsv1020.github.io/thai-policy-lineage

# ── 站点统计(app.stats,第一方、无 Cookie、不存 IP)──
STATS_ENABLED=1
# 统计后台 /admin 的访问令牌;不设则后台接口一律 404。生成:openssl rand -hex 24
# ADMIN_TOKEN=
# 访客哈希密钥;不设则每次重启随机生成,重启当天访客会重复计数。生成:openssl rand -hex 24
# STATS_SECRET=
STATS_RETENTION_DAYS=400
